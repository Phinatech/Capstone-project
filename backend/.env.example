# Server
PORT=3001
NODE_ENV=development

# Chain / contracts
RPC_URL=http://localhost:8545
ORACLE_AGGREGATOR_ADDRESS=
WEATHER_INDEX_INSURANCE_ADDRESS=

# Oracle relayer
# Comma-separated list of "label:private_key" pairs, one per registered source.
# Use throwaway keys on testnets only. Never commit the real .env file.
ORACLE_SOURCES=
RELAYER_INTERVAL_MINUTES=60

# Rainfall data providers (get free keys at their respective portals)
CHIRPS_API_URL=
NASA_POWER_API_URL=
METEOSTAT_API_KEY=
