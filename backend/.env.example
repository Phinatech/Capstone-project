# Server
PORT=3001
NODE_ENV=development
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Cloudflare Turnstile secret key (Cloudflare dashboard > Turnstile > your widget).
# Pairs with VITE_TURNSTILE_SITE_KEY in frontend/.env. Never commit the real one.
TURNSTILE_SECRET_KEY=

# SMS through Termii (POST /api/notify/sms). The sender ID must be approved on
# your Termii account, and Termii support must activate the dnd channel.
TERMINII_API_KEY=
TERMINII_SENDER_ID=
# Secret callers of the SMS endpoint send as "Authorization: Bearer <key>";
# empty keeps the endpoint off. Make one with: openssl rand -hex 32
NOTIFY_API_KEY=

# Chain / contracts
RPC_URL=http://localhost:8545
ORACLE_AGGREGATOR_ADDRESS=
WEATHER_INDEX_INSURANCE_ADDRESS=
# Block the contracts were deployed in; event history is read from here (0 on a local chain).
DEPLOY_BLOCK=0
# Event history (eth_getLogs) RPC; empty uses RPC_URL. It must keep logs back to
# DEPLOY_BLOCK and allow LOGS_BLOCK_RANGE blocks per request. Alchemy's free tier
# allows only 10 and PublicNode prunes old logs; on Sepolia
# https://sepolia.gateway.tenderly.co with LOGS_BLOCK_RANGE=50000 works.
LOGS_RPC_URL=
LOGS_BLOCK_RANGE=10000

# Oracle relayer and settlement keeper
# They submit real transactions, so they only run when RELAYER_ENABLED=true.
# Each run reports the last RELAYER_LOOKBACK_DEKADS finished dekads that a
# source hasn't reported yet, then finalizes ready dekads and settles policies.
RELAYER_ENABLED=false
# Comma-separated list of "label:private_key" pairs, one per registered source.
# Use throwaway keys on testnets only. Never commit the real .env file.
ORACLE_SOURCES=
# Account that pays the gas to finalize dekads and settle policies (anyone may
# call both); empty turns settlement off. Fund it with a little test ETH.
KEEPER_PRIVATE_KEY=
RELAYER_INTERVAL_MINUTES=60
RELAYER_LOOKBACK_DEKADS=3

# Rainfall data providers
# Location the feeds are read for (default: Sokoto).
RAINFALL_LATITUDE=13.05
RAINFALL_LONGITUDE=5.23
# NASA POWER needs no key; empty uses https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_API_URL=
# Meteostat through RapidAPI (free plan: 500 requests a month). Empty makes the
# Meteostat source replay historical data instead.
METEOSTAT_API_KEY=
# Not used yet: CHIRPS still replays historical data.
CHIRPS_API_URL=
