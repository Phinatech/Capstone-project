# Server
PORT=3001
NODE_ENV=development
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# --- Server-side auth (F-1) ---
# User directory and session store, as JSON files beside the agent ledger.
# Empty uses backend/data/users.json and backend/data/sessions.json.
USERS_PATH=
SESSIONS_PATH=
SESSION_COOKIE_NAME=sokoto_cover_session
# true ONLY for HTTPS deployments, where the cookie must carry Secure. The dev
# UI reaches the API same-origin through Vite's proxy, where SameSite=Lax alone
# is sufficient over plain http.
SECURE_COOKIES=false

# Google sign-in. Must equal VITE_GOOGLE_CLIENT_ID in frontend/.env — ID tokens
# are verified against this audience, so a token minted for a different client
# is rejected. Empty leaves /auth/google answering 503.
GOOGLE_CLIENT_ID=

# THE OPERATOR (ADMINISTRATOR) ACCOUNT — seeded at every boot, so the
# deployment can never be locked out. The credentials live here and in the
# service's environment, never in the repository. Without them no
# administrator account exists.
ADMIN_EMAIL=
ADMIN_NAME=Programme administrator
ADMIN_PASSWORD=

# OPERATOR-PROVISIONED ACCOUNTS — a JSON array, recreated at every boot.
# Sign-up accounts live on an ephemeral disk and a redeploy wipes them; the
# agent and farmers a deployment runs with belong here instead. Roles are
# "farmer" and "agent" only; ids default to role-N in list order (set "id"
# explicitly to keep receipts pointing at the same farmer). Accounts created
# here are marked email-verified.
# SEED_USERS=[{"role":"agent","name":"Fatima Abdullahi","email":"fatima@example.com","password":"Agent#2023","phone":"+234 800 000 0000","lga":"Wamakko"}]
SEED_USERS=

# DATABASE — PostgreSQL connection string (Neon and Supabase have free
# tiers). Set it and accounts, sessions and agent receipts survive every
# deploy and restart; leave it empty and they live in local JSON files
# (development and tests).
DATABASE_URL=

# OUTBOUND MAIL — verification codes and password resets arrive in the
# recipient's inbox. Gmail works out of the box: MAIL_USER is a Gmail address
# and MAIL_PASSWORD a Google App Password (Google Account → Security →
# 2-Step Verification → App passwords). Unset, no mail is sent and codes go
# to the server log for an operator to relay.
MAIL_USER=
MAIL_PASSWORD=
# Optional, for a non-Gmail SMTP service:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=Sokoto Rainfall Cover

# DEMO AFFORDANCES — both default OFF; a fresh clone starts with neither.
# AUTH_DEMO_ACCOUNTS: seeds the demo roster (a field agent and four farmers)
#   for local demonstrations.
# AUTH_DEMO_CODES: returns verification codes and password-reset tokens in the
#   response, because no mail service sends them. NEVER set true anywhere a
#   real user signs in — anyone could then request a reset for any account and
#   complete it without access to that inbox. Leave off and the server logs the
#   code for an operator to relay instead.
AUTH_DEMO_ACCOUNTS=false
AUTH_DEMO_CODES=false
# Minimum password length at sign-up and on password change.
MIN_PASSWORD_LENGTH=8

# Cloudflare Turnstile secret key (Cloudflare dashboard > Turnstile > your widget).
# Pairs with VITE_TURNSTILE_SITE_KEY in frontend/.env. Never commit the real one.
TURNSTILE_SECRET_KEY=

# SMS: policy notifications and POST /api/notify/sms. SMS_PROVIDER is
# "africastalking" (default) or "termii".
SMS_PROVIDER=africastalking
# Africa's Talking: with the username "sandbox" messages are free and appear in
# the online simulator (developers.africastalking.com/simulator), not on real
# phones. A live app username sends real SMS; Nigeria needs an approved sender ID.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
# Numbers that get an SMS for every policy bought or settled (e.g. your demo
# phone or simulator number), comma-separated. The policy's farmer also gets
# one when their profile wallet owns the policy and has a phone number.
NOTIFY_SMS_TO=
# Termii (SMS_PROVIDER=termii): the sender ID must be approved on your Termii
# account, and Termii support must activate the dnd channel.
TERMINII_API_KEY=
TERMINII_SENDER_ID=
# Secret callers of the SMS endpoint send as "Authorization: Bearer <key>";
# empty keeps the endpoint off. Make one with: openssl rand -hex 32
NOTIFY_API_KEY=

# Telegram notifications for every policy bought or settled (sent by the
# backend that has RELAYER_ENABLED=true). Create the bot with @BotFather, send
# it a message, then put its token here and your chat id below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Block explorer the messages link to (default: Sepolia Etherscan)
EXPLORER_URL=

# Chain / contracts
RPC_URL=http://localhost:8545
ORACLE_AGGREGATOR_ADDRESS=
WEATHER_INDEX_INSURANCE_ADDRESS=
# Block the contracts were deployed in; event history is read from here (0 on a local chain).
DEPLOY_BLOCK=0
# Event history (eth_getLogs) RPC; empty uses RPC_URL. It must keep logs back to
# DEPLOY_BLOCK and allow LOGS_BLOCK_RANGE blocks per request. Alchemy's free tier
# allows only 10 and PublicNode prunes old logs; on Sepolia
# https://sepolia.gateway.tenderly.co with LOGS_BLOCK_RANGE=50000 works.
LOGS_RPC_URL=
LOGS_BLOCK_RANGE=10000

# Oracle relayer and settlement keeper
# They submit real transactions, so they only run when RELAYER_ENABLED=true.
# Each run reports the last RELAYER_LOOKBACK_DEKADS finished dekads that a
# source hasn't reported yet, then finalizes ready dekads and settles policies.
RELAYER_ENABLED=false
# Comma-separated list of "label:private_key" pairs, one per registered source.
# Use throwaway keys on testnets only. Never commit the real .env file.
ORACLE_SOURCES=
# Account that pays the gas to finalize dekads and settle policies (anyone may
# call both); empty turns settlement off. Fund it with a little test ETH.
KEEPER_PRIVATE_KEY=
RELAYER_INTERVAL_MINUTES=60
RELAYER_LOOKBACK_DEKADS=3

# Rainfall data providers
# Location the feeds are read for (default: Sokoto).
RAINFALL_LATITUDE=13.05
RAINFALL_LONGITUDE=5.23
# NASA POWER needs no key; empty uses https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_API_URL=
# Meteostat through RapidAPI (free plan: 500 requests a month). Empty makes the
# Meteostat source replay historical data instead.
METEOSTAT_API_KEY=
# Not used yet: CHIRPS still replays historical data.
CHIRPS_API_URL=
