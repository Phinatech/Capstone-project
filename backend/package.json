{
  "name": "@weather/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API + oracle relayer service for the weather-index insurance dapp",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "ethers": "^6.17.0",
    "express": "^5.1.0",
    "firebase-admin": "^14.5.0",
    "geotiff": "^3.0.5",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.20.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
