6" as="geometry"/></mxCell><mxCell id="fig-3-2-9" value="one signed reading per source per dekad" style="fontFamily=Helvetica;fontColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fig-3-2-4" target="fig-3-2-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fig-3-2-10" value="At least 2 sources reported AND&lt;br&gt;(all reported OR 1 day passed)?" style="fontFamily=Helvetica;fontColor=#000000;rhombus;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="350" width="300" height="170" as="geometry"/></mxCell><mxCell id="fig-3-2-11" value="" style="fontFamily=Helvetica;fontColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fig-3-2-8" target="fig-3-2-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fig-3-2-12" value="Wait for more readings" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="10" y="415" width="160" height="40" as="geometry"/></mxCell><mxCell id="fig-3-2-13" value="no" style="fontFamily=Helvetica;fontColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="fig-3-2-10" target="fig-3-2-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fig-3-2-14" value="&lt;b&gt;finalizePeriod&lt;/b&gt;&lt;br&gt;aggregate = sum(w × reading) / sum(w)&lt;br&gt;over sources that reported" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="200" y="565" width="360" height="70" as="geometry"/></mxCell><mxCell id="fig-3-2-15" value="yes" style="fontFamily=Helvetica;fontColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fig-3-2-10" target="fig-3-2-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fig-3-2-16" value="Window rainfall = sum of its finalised dekads" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="220" y="680" width="320" height="44" as="geometry"/></mxCell><mxCell id="fig-3-2-17" value="" style="fontFamily=Helvetica;fontColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fig-3-2-14" target="fig-3-2-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fig-3-2-18" value="Window rainfall below&lt;br&gt;the policy threshold?" style="fontFamily=Helvetica;fontColor=#000000;rhombus;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="265" y="765" width="230" height="140" as="geometry"/></mxCell><mxCell id="fig-3-2-19" value="" style="fontFamily=Helvetica;fontColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fig-3-2-16" target="fig-3-2-18"><mxGeometry r