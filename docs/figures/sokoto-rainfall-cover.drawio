 x="10" y="320" width="780" height="130" as="geometry"/></mxCell><mxCell id="fig-3-3-11" value='&lt;b&gt;Oracle relayer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;one signing key per source; complete dekads only&lt;/font&gt;' style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="fig-3-3-10"><mxGeometry x="15" y="38" width="175" height="74" as="geometry"/></mxCell><mxCell id="fig-3-3-12" value='&lt;b&gt;Settlement keeper&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;finalizePeriod, checkAndSettle, hourly&lt;/font&gt;' style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="fig-3-3-10"><mxGeometry x="205" y="38" width="175" height="74" as="geometry"/></mxCell><mxCell id="fig-3-3-13" value='&lt;b&gt;REST API&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;sessions, roles, receipt verification, stale-while-revalidate cache&lt;/font&gt;' style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="fig-3-3-10"><mxGeometry x="395" y="38" width="150" height="74" as="geometry"/></mxCell><mxCell id="fig-3-3-14" value='&lt;b&gt;Notifier&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;policy and payout events to in-app, SMS and Telegram&lt;/font&gt;' style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="fig-3-3-10"><mxGeometry x="560" y="38" width="205" height="74" as="geometry"/></mxCell><mxCell id="fig-3-3-15" value="same-origin REST (JSON)" style="fontFamily=Helvetica;fontColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#