# Dependencies
node_modules/

# Builds & output
dist/
build/
coverage/

# Vite
frontend/dist/
.vite/

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*

# Claude Code (kept locally, not tracked)
CLAUDE.md
.claude/

# Editor / OS
.DS_Store
.idea/
*.swp

# Oracle feed caches (regenerated at runtime, never committed)
backend/data/chirps-daily-cache.json

# Runtime data written by the API (never commit farmer/agent records)
backend/data/agent-sales.json
backend/data/agent-sales.json.tmp

# Accounts and live sessions — server-side since F-1. The user file holds
# password hashes and the session file holds unexpired session ids; neither
# belongs in git, and both are rebuilt by seeding if lost.
backend/data/users.json
backend/data/users.json.tmp
backend/data/sessions.json
backend/data/sessions.json.tmp
