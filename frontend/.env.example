# Backend API the UI talks to — leave EMPTY unless the backend is elsewhere.
#
# Empty = relative paths, proxied by Vite to http://localhost:3001 (vite.config.ts).
# One origin in the browser is what lets the httpOnly session cookie ride along
# with API requests. Filling in an absolute URL makes calls cross-origin, and a
# SameSite=Lax cookie is not sent on a cross-origin fetch — so every request
# would come back signed out. In production, serve the UI and API together (or
# behind one reverse proxy) and leave this empty.
VITE_API_URL=

# Cloudflare Turnstile site key. Leave empty for the demo: Cloudflare's
# always-pass test key is used and no backend check happens. With a real key,
# every token is verified by the backend (set TURNSTILE_SECRET_KEY there).
VITE_TURNSTILE_SITE_KEY=

# Chain + deployed contract addresses (fill after `ignition deploy`)
VITE_RPC_URL=
VITE_ORACLE_AGGREGATOR_ADDRESS=
VITE_WEATHER_INDEX_INSURANCE_ADDRESS=
